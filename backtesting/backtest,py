# run_backtest.py
import pandas as pd
from backtesting import Strategy, Backtest
from backtesting.test import SMA
from get_mt5_data import get_mt5_ohlc_data

# 1. Load the data saved in Step 2
# df = pd.read_pickle("EURUSD_D1_Data.pkl")
df = get_mt5_ohlc_data("#BTCUSD", "D1", 0, 10)

# 2. Define your trading strategy logic within a Python class
class SmaCross(Strategy):
    n1 = 10 # Fast SMA periods
    n2 = 20 # Slow SMA periods

    def init(self):
        # Precompute indicators once at the start
        self.sma1 = self.I(SMA, self.data.Close, self.n1)
        self.sma2 = self.I(SMA, self.data.Close, self.n2)

    def next(self):
        # Trading logic evaluated bar-by-bar
        if self.sma1[-1] > self.sma2[-1] and self.sma1[-2] < self.sma2[-2]:
            # Close any existing short positions and go long
            self.buy()
        elif self.sma1[-1] < self.sma2[-1] and self.sma1[-2] > self.sma2[-2]:
            # Close any existing long positions and go short
            self.sell()

# 3. Initialize and run the backtest
bt = Backtest(df, SmaCross, 
              cash=10000, 
              commission=.002,  # 0.2% commission
              exclusive_orders=True)

stats = bt.run()

# 4. Print results (or plot them)
print(stats)
